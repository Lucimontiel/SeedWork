# ============================================================
# ENTORNO
# ============================================================
ENV=dev

# ============================================================
# BASE DE DATOS (MySQL)
# ============================================================
DATABASE_URL=mysql+pymysql://root:3217361186Vila@localhost:3306/seedwork

# ============================================================
# JWT
# ============================================================
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CAMBIA_ESTO_POR_UNA_CLAVE_LARGA_Y_ALEATORIA
JWT_ALGORITHM=HS256

# ============================================================
# DURACION DE TOKENS
# ============================================================
ACCESS_TOKEN_EXPIRE_MINUTES_CANDIDATO=30
ACCESS_TOKEN_EXPIRE_MINUTES_EMPRESA=20
ACCESS_TOKEN_EXPIRE_MINUTES_ADMIN=10

REFRESH_TOKEN_EXPIRE_DAYS_CANDIDATO=30
REFRESH_TOKEN_EXPIRE_DAYS_EMPRESA=14
REFRESH_TOKEN_EXPIRE_HOURS_ADMIN=8

# ============================================================
# COOKIES
# ============================================================
# En dev: false (localhost). En prod: true (requiere HTTPS).
COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax

# ============================================================
# CORS
# ============================================================
CORS_ORIGINS=http://localhost:3000

# ============================================================
# RATE LIMITING
# ============================================================
# Formato slowapi: "N/periodo". Ej: 10/minute, 100/hour
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REGISTRO=5/minute
RATE_LIMIT_REFRESH=30/minute

# ============================================================
# BLOQUEO POR INTENTOS FALLIDOS
# ============================================================
MAX_INTENTOS_FALLIDOS=5
BLOQUEO_MINUTOS=15